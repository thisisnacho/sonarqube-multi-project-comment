{
  "name": "sonarqube-multi-project-comment",
  "version": "0.1.0",
  "private": true,
  "description": "GitHub Action that aggregates multi-project SonarQube results into a single PR comment.",
  "main": "dist/index.js",
  "scripts": {
    "build": "ncc build src/index.ts -o dist --source-map --license licenses.txt",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "dependencies": {
    "@actions/core": "^1.11.1",
    "@actions/github": "^6.0.0",
    "@actions/glob": "^0.5.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@vercel/ncc": "^0.38.1",
    "prettier": "^3.3.0",
    "typescript": "^5.5.0"
  }
}
